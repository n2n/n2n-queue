{
	"name" : "n2n/n2n-queue",
	"type" : "library",
	"description" : "php queue utils by n2n",
	"keywords" : [
		"n2n"
	],
	"homepage" : "https://n2n.rocks/",
	"license" : "LGPL-3.0-or-later",
	"authors" : [
		{
			"name" : "Andreas von Burg",
			"email" : "a@von-burg.net",
			"homepage" : "https://www.von-burg.net/"
		}
	],
	"minimum-stability" : "dev",
	"prefer-stable": true,
	"config" : {
		"vendor-dir" : "src/vendor",
		"allow-plugins": {
			"n2n/n2n-composer-module-installer": true
		}
	},
	"require" : {
		"php": ">=8.4",
		"n2n/n2n-util": "~7.5.0",
		"n2n/n2n-concurrency": "~7.5.0",
        "n2n/n2n-spec-dbo": "~1.0",
        "n2n/n2n-util-serialize": "~7.5.0"
    },
	"autoload" : {
		"psr-4" : {
			"n2n\\queue\\" : "src/app/n2n/queue"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"n2n\\queue\\": "src/test/n2n/queue"
		}
	},
	"require-dev" : {
		"phpunit/phpunit" : "^9.6.19",
		"n2n/n2n-impl-persistence-meta": "^7.5.0",
		"n2n/n2n-test": "^7.4",
		"ext-ctype": "*",
		"ext-mbstring": "*"
	},
    "suggest": {
        "ext-igbinary": "*"
    }
}
